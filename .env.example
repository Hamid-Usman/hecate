# Where hecates-backend runs (server-side only; the browser never calls it directly).
API_URL=http://localhost:3000

# The public address of the Hecate engine that developers' apps sync with. Shown in the Connect guide
# and code snippets, and health-checked from the dashboard. It must be the engine whose project
# directory is this backend (engine run with --projects-url pointing at it).
ENGINE_URL=http://localhost:8080
